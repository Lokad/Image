  "design": {
    "project": "Lokad.Image",
    "stage": "JGB269",
    "repeatedWork": "Scalar conversion/rounding and per-sample edge selection after each already normalized packed RGB row. Batch eight independent pixels with exact binary64 AVX operations; replicate the final edge sample once.",
    "endState": "One bounded row helper, safe AVX2 path with original scalar fallback. No FMA, new buffers, owners, cache, session, numerical policy or admission.",
    "scope": "Existing complete RGBA8 to grayscale JPEG Q69/0x204060 control, frozen58910B packet; labeled SIMDlibjpeg-turbo. CallerGRAY bypasses this path and reuses unchanged proof. CallerRGB branch unchanged. Generalization is existing8/16edge/flatten block corpus plus exhaustive24bit RGB conversion, not a performance settings grid.",
    "correctness": "Preserve separate .299*r + .587*g, then .114*b, then +.5/floor operations in binary64. Every24bitRGB input must match. Frozen actual block/packet, scalar, ownership/cancel/admission checks before short. Confirm only if useful complete lead.",
    "temporaryState": "Original scalar helper retained only as portable fallback. No temporary alternate public API or dual encoder.",
    "priorWork": "WARM-JPEG-GRAY-ROWS batches normalization but leaves gray conversion scalar. Earlier AVX2transform/quantization/entropy work is distinct and retained. Current confirmedRGBAgray gap1.126/upper1.137; differences between callerGRAY/RGBA costs are not method cost attribution.",
    "newProfiles": 0,
    "newPerformanceControls": 0
  },
