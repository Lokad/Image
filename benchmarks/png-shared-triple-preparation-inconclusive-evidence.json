  "hypothesis": {
    "removedWork": "Three byte loads for greedy hash, followed by a word and byte load of the same target for search. Prepare one explicit-LE ushort prefix and third byte, reuse for both ordered dictionary insertion and candidate probes.",
    "endState": "Existing Pair/Byte acquisition once per insertion position with >=3 acquired bytes. Small typed insertion helper consumes prepared prefix/third; existing insertion callers share the helper. Search retains prefix and initial tail. No rolling hash or session/pool/owner/cache.",
    "correctness": {
      "all65536LittleEndianPrefixContributionsExact": true,
      "allThirdBytesCoveredByIdenticalXorAndMask": true,
      "noFourByteReadNeeded": true,
      "prepareOnlyWhenThreeAcquiredBytesRemain": true,
      "wordReadPortableThroughBinaryPrimitives": true,
      "chainInsertionAndTieOrderUnchanged": true,
      "cancellationPublicationBlockAndSlideBoundariesRequired": true
    },
    "prior": "Rolling-hash field/local, generic cancellation and long-match caller-transfer adverse/inconclusive trials are distinct and remain. Existing prepared probe stage already reuses prefix inside candidate loop; this design shares preparation between hash and search.",
    "risks": "Additional live prefix/third locals or helper inlining may increase spills/code size. Validate generated code and complete workloads; fewer source/JIT loads alone is not speed proof.",
    "ownership": "No new storage/capacity/reservation. Preserve exact packets, source/output independent lifetimes, local384KiB and borrowed shared admission/terminal refusal/cancellation cleanup.",
    "productionPrototype": "Single explicit-LE prefix/third acquisition feeds greedy hash, search and literal token. Short-match backfill shares typed insertion helper. Final <3 bytes acquire only literal. No rolling state, 4byte read, storage or owner."
  },
