<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <LokadImageAssembly Condition="'$(LokadImageAssembly)' == ''">../../src/Lokad.Image/bin/Release/net10.0/Lokad.Image.dll</LokadImageAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <Reference Include="Lokad.Image"><HintPath>$(LokadImageAssembly)</HintPath></Reference>
    <Compile Include="../Shared/TestMemoryBudget.cs" Link="TestMemoryBudget.cs" />
  </ItemGroup>
</Project>
