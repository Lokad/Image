<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <!-- Exact per-thread allocation assertions need stable allocation-context
         accounting: https://github.com/dotnet/runtime/pull/134855 .
         This affects only this test host; public/differential hosts retain
         default GC settings and production has no runtime policy. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <Using Include="Xunit" />
    <Compile Include="../../src/Lokad.Image/**/*.cs" Exclude="../../src/Lokad.Image/bin/**;../../src/Lokad.Image/obj/**" LinkBase="Production" />
    <Compile Include="../../tools/Shared/AuthoredTrueType.cs" Link="Shared/AuthoredTrueType.cs" />
    <Compile Include="../../tools/Shared/AuthoredOpenType.cs" Link="Shared/AuthoredOpenType.cs" />
    <Compile Include="../../tools/Shared/TestMemoryBudget.cs" Link="Shared/TestMemoryBudget.cs" />
    <Compile Include="../../tools/Shared/OriginalPixels.cs" Link="Shared/OriginalPixels.cs" />
    <Compile Include="../../tools/Shared/OriginalDeflateMatch.cs" Link="Shared/OriginalDeflateMatch.cs" />
    <Compile Include="../../tools/Shared/OriginalVp8lControls.cs" Link="Shared/OriginalVp8lControls.cs" />
    <Compile Include="../../tools/Shared/OriginalJpegInverseControls.cs" Link="Shared/OriginalJpegInverseControls.cs" />
    <Compile Include="../../tools/Shared/LanczosReference.cs" Link="Shared/LanczosReference.cs" />
    <Compile Include="../../tools/WarmReference/PalettePackingInput.cs" Link="Shared/PalettePackingInput.cs" />
    <Compile Include="../../tools/WarmReference/JpegInverseStage.cs" Link="Stages/JpegInverseStage.cs" />
  </ItemGroup>
</Project>
