<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Lokad.Image</PackageId>
    <Version>0.2.0</Version>
    <Authors>Lokad</Authors>
    <Company>Lokad</Company>
    <Description>Safe managed image codecs and basic image editing for .NET.</Description>
    <PackageTags>image;png;jpeg;webp;codec</PackageTags>
    <PackageReleaseNotes>Development toward 0.2.0: expanded JPEG and stream support, drawing, supplied TrueType text and caller-owned cooperative memory admission. See CHANGELOG.md and SPEC.md for verified scope and limitations.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/lokad/image</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lokad/image.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>../../artifacts/nuget/</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../SPEC.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/resource-admission.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/codec-parity.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/lanczos3-fma-certificate.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/jpeg-inverse-rounding.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/jpeg-forward-quantization.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/usage.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/migration.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
  <Target Name="RequireReleasePackage" BeforeTargets="GenerateNuspec" Condition="'$(Configuration)' != 'Release'">
    <Error Text="Produce NuGet packages with -c Release." />
  </Target>
</Project>
